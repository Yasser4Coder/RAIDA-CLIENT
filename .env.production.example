# Used by `npm run build:production`.
# Vite bakes these into the public JS bundle — never put secrets here.

# Live website origin (https, no trailing slash).
VITE_SITE_URL=https://raaida.net

# Same-origin API (website reverse-proxies /api and /uploads to RAIDA-SERVER):
VITE_API_BASE_URL=/api/v1

# Or an absolute API host:
# VITE_API_BASE_URL=https://api.raaida.net/api/v1
