# Local / Vite proxy (default)
VITE_API_BASE_URL=/api/v1

# Production: set this in your host env (Vercel/Netlify/etc) to the real backend URL.
# Example:
# VITE_API_BASE_URL=https://your-api-host.com/api/v1

# Public site origin used for canonical URLs, Open Graph, and JSON-LD (no trailing slash).
# VITE_SITE_URL=https://raaida.net
